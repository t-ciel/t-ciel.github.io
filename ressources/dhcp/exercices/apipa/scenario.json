      "config": {
        "ipv4": {
          "interfaceId": "eth0",
          "mode": "static",
          "address": "192.168.30.2",
          "prefix": 24
        },
        "dhcpEnabled": true,
        "dhcpPool": {
          "start": "192.168.30.100",
          "end": "192.168.30.110",
